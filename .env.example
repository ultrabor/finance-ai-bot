APP_ENV=development
LOG_LEVEL=debug
# Часовой пояс семьи: от него считаются «сегодня», «вчера», «этот месяц»
APP_TIMEZONE=Europe/Moscow

HTTP_HOST=localhost
HTTP_PORT=8080
# Порты на хосте при запуске через docker compose
API_PORT=8080
WEB_PORT=3000
# Адрес публикации портов api и web. 0.0.0.0 открывает панель без авторизации в сеть — только в доверенном окружении
BIND_ADDR=127.0.0.1

POSTGRES_USER=user
POSTGRES_PASSWORD=qwerty1
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=db
POSTGRES_MAX_CONNS=10

# Telegram: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram ID членов семьи через запятую (обязательно; свой ID можно узнать у @userinfobot)
FAMILY_TELEGRAM_IDS=
# true — отвечать всем без белого списка (только для демо)
TELEGRAM_ALLOW_ALL=false

# LLM: любой OpenAI-совместимый Chat Completions API с поддержкой tool calling.
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4.1-mini
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=anthropic/claude-haiku-4.5
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1    LLM_MODEL=openai/gpt-oss-120b  (бесплатный тариф: ~8K токенов/мин)
# Ollama:     LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=qwen2.5:7b  (LLM_API_KEY не нужен)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Таймаут одного запроса; до 3 попыток должны уложиться в 90 с на ответ бота
LLM_TIMEOUT=30s
# Пусто — параметр не передаётся (некоторые модели принимают только значение по умолчанию)
LLM_TEMPERATURE=0
LLM_MAX_STEPS=8
# Необязательно: свой шаблон промпта вместо встроенного (копия internal/agent/prompts/system.tmpl).
# Читается при старте бота; ошибка в шаблоне не даёт боту запуститься. В Docker смонтируйте файл в контейнер bot.
AGENT_PROMPT_PATH=
